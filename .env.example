# Names only. Real values live in .env (gitignored). `stripe projects add createos/project` writes the CREATEOS_* ones.
APP_ENV=development
LOG_FORMAT=console
SANDTRAP_API_KEY=            # optional; empty = open API (local demo)

# CreateOS (written by Stripe Projects)
CREATEOS_PROJECT_API_KEY=
CREATEOS_SANDBOX_BASE_URL=https://api-eu.sb.createos.sh

# LLM provider: gemini (Vertex AI through your gcloud login) or k2
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_PROJECT=            # your Google Cloud project id with Vertex AI enabled
GEMINI_LOCATION=global
GCLOUD_ACCOUNT=            # the gcloud account to use (empty = the active one)

# Alternative providers (OpenAI-compatible)
K2_API_KEY=
K2_BASE_URL=https://api.ifm.ai/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional
VIRUSTOTAL_API_KEY=
FILE_TRACING_ENABLED=true

# Langfuse (free cloud project at https://cloud.langfuse.com; US: https://us.cloud.langfuse.com). Leave empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM routing for LangChain "openai:" models (defaults to K2); deep-research tuning
K2_MODEL=IFM/K2-Horizon-375B-A23B
K2_REASONING_EFFORT=low
LOG_LEVEL=INFO
GRAPH_LLM_IDLE_TIMEOUT=150

# Neon Postgres (written by `stripe projects add neon/postgres` once linked)
